command = /bin/zsh --login
window-decoration = true 
background = 0a0a0a
background-opacity = 1

tab-inherit-working-directory = true

font-family = JetBrainsMono Nerd Font
font-size = 22

cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true

window-padding-x = 8
window-padding-y = 4

copy-on-select = true
